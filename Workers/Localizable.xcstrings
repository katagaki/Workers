    "More.Usage.FreeFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Free plan allows 100,000 requests per day across Workers and Pages Functions, resetting at 00:00 UTC. Requests over the limit fail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランでは Workers と Pages Functions を合わせて1日100,000リクエストまで利用でき、UTC 0:00 にリセットされます。上限を超えたリクエストは失敗します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 요금제는 Workers와 Pages Functions를 합쳐 하루 100,000개의 요청을 허용하며, UTC 00:00에 초기화됩니다. 한도를 초과한 요청은 실패합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费套餐每天允许 Workers 和 Pages Functions 共计 100,000 个请求，于 UTC 00:00 重置。超出限制的请求将失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費方案每天允許 Workers 與 Pages Functions 合計 100,000 個請求，於 UTC 00:00 重設。超過上限的請求將會失敗。"
          }
        }
      }
    },
    "More.Usage.Month" : {
