      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gets the number of requests a worker handled in the last 24 hours."
          }
        },
        "ja" : {
          "stringUnit" : {
