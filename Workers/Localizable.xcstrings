    "Logs.Empty.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Workers Logs in your Wrangler configuration to see recent logs here, or switch to Live to tail requests as they happen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrangler の設定で Workers Logs を有効にすると最近のログがここに表示されます。または「ライブ」に切り替えてリクエストをリアルタイムで追跡できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrangler 구성에서 Workers Logs를 활성화하면 최근 로그가 여기에 표시됩니다. 또는 실시간으로 전환하여 요청을 실시간으로 추적할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Wrangler 配置中启用 Workers Logs 即可在此查看最近的日志，或切换到“实时”以在请求发生时跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Wrangler 設定中啟用 Workers Logs 即可在此查看最近的記錄，或切換至「即時」以在請求發生時追蹤。"
          }
        }
      }
    },
