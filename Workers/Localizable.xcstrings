    "More.Usage.PaidFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Paid plan includes 10 million requests per month. Usage is counted from the start of the month (UTC), which may not match your billing period. Requests over the included amount are billed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有料プランには月1,000万リクエストが含まれます。使用量は月初（UTC）から集計されるため、請求期間と一致しない場合があります。含まれる量を超えたリクエストは課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유료 요금제에는 매월 1,000만 개의 요청이 포함됩니다. 사용량은 매월 1일(UTC)부터 집계되므로 청구 기간과 다를 수 있습니다. 포함량을 초과한 요청에는 요금이 부과됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付费套餐每月包含 1000 万个请求。用量从每月月初（UTC）开始计算，可能与你的账单周期不一致。超出包含量的请求将被计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付費方案每月包含 1,000 萬個請求。用量從每月月初（UTC）開始計算，可能與你的帳單週期不一致。超過包含量的請求將會計費。"
          }
        }
      }
    },
