    "Domains.Pause.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausing Cloudflare sends traffic directly to your origin without Cloudflare's protection or caching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare を一時停止すると、Cloudflare の保護やキャッシュを経由せずにトラフィックがオリジンに直接送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare를 일시 정지하면 Cloudflare의 보호나 캐싱 없이 트래픽이 원본 서버로 직접 전송됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停 Cloudflare 会将流量直接发送到你的源服务器，不经过 Cloudflare 的保护或缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停 Cloudflare 會將流量直接傳送至你的來源伺服器，不經過 Cloudflare 的保護或快取。"
          }
        }
      }
    },
